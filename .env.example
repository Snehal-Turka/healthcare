# .env.example
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
DEFAULT_PROVIDER="openai"     # openai | sarvam | amazon
RETAIN_AUDIO="false"          # set true to keep uploaded/recorded audio locally
STORAGE_DIR=".data/audio"     # used only when RETAIN_AUDIO=true
OPENAI_API_KEY=""
SARVAM_API_KEY=""
HC_AWS_REGION="ap-south-1"       # Mumbai
HC_AWS_S3_BUCKET=""
HC_AWS_ACCESS_KEY_ID=""
HC_AWS_SECRET_ACCESS_KEY=""
